import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'package:uuid/uuid.dart';
import '../database/database_helper.dart';
import '../models/game_telemetry.dart';

class VisualMemoryGame extends StatefulWidget {
  const VisualMemoryGame({super.key});

  @override
  State<VisualMemoryGame> createState() => _VisualMemoryGameState();
}

class _VisualMemoryGameState extends State<VisualMemoryGame> {
  final List<Map<String, String>> nerAssets = [
    {'name': 'Dhol (Bihu)', 'icon': '🥁'},
    {'name': 'One-horned Rhino', 'icon': '🦏'},
    {'name': 'Tea Garden', 'icon': '🍃'},
    {'name': 'Hornbill', 'icon': '🦅'},
  ];

  late Map<String, String> targetItem;
  late Stopwatch stopwatch;
  int hesitationCount = 0;
  bool isGameActive = false;
  int pendingLogsCount = 0;
  int currentLevel = 1;

  @override
  void initState() {
    super.initState();
    _refreshPendingLogs();
    _startNewRound();
  }

  Future<void> _refreshPendingLogs() async {
    final logs = await DatabaseHelper.instance.getUnsyncedTelemetry();
    setState(() {
      pendingLogsCount = logs.length;
    });
  }

  void _startNewRound() {
    nerAssets.shuffle();
    targetItem = nerAssets.first;
    stopwatch = Stopwatch()..start();
    hesitationCount = 0;
    isGameActive = true;
    setState(() {});
  }

  Future<void> _handleChoice(Map<String, String> selectedItem) async {
    if (!isGameActive) return;

    if (selectedItem['name'] == targetItem['name']) {
      stopwatch.stop();
      isGameActive = false;

      final reactionTime = stopwatch.elapsedMilliseconds;
      final accuracy = hesitationCount == 0 ? 1.0 : 0.5;

      if (reactionTime < 1800 && hesitationCount == 0) {
        currentLevel = (currentLevel < 5) ? currentLevel + 1 : 5;
      } else if (reactionTime > 4000 || hesitationCount > 2) {
        currentLevel = (currentLevel > 1) ? currentLevel - 1 : 1;
      }

      final fatigueIndex =
          (reactionTime > 3000 ? 0.3 : 0.05) + (hesitationCount * 0.1);

      final log = GameTelemetry(
        logId: const Uuid().v4(),
        patientId: 'patient_001',
        gameType: 'visual_memory_ner',
        difficultyLevel: currentLevel,
        reactionTimeMs: reactionTime,
        accuracyScore: accuracy,
        hesitationCount: hesitationCount,
        cognitiveFatigueIndex: fatigueIndex,
        playedAt: DateTime.now().toIso8601String(),
      );

      await DatabaseHelper.instance.insertTelemetry(log);
      await _refreshPendingLogs();

      _showSuccessDialog(reactionTime, currentLevel);
    } else {
      setState(() {
        hesitationCount++;
      });
    }
  }

  Future<void> _syncLocalLogsToServer() async {
    final unsyncedLogs = await DatabaseHelper.instance.getUnsyncedTelemetry();
    if (unsyncedLogs.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('All local logs are synced!')),
      );
      return;
    }

    final payload = {
      'logs': unsyncedLogs.map((l) => l.toMap()).toList(),
    };

    try {
      final response = await http.post(
        Uri.parse('http://localhost:5001/api/telemetry/sync'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode(payload),
      );

      if (response.statusCode == 200) {
        final logIds = unsyncedLogs.map((l) => l.logId).toList();
        await DatabaseHelper.instance.markTelemetryAsSynced(logIds);
        await _refreshPendingLogs();

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
              content: Text(
                  'Synced ${unsyncedLogs.length} logs to cloud successfully!')),
        );
      }
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
            content: Text(
                'Backend connection failed. Saved to local storage queue.')),
      );
    }
  }

  void _showSuccessDialog(int timeMs, int level) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => AlertDialog(
        title: const Text('🎉 Correct!',
            style: TextStyle(fontSize: 26, color: Colors.green)),
        content: Text(
          'Response time: ${(timeMs / 1000).toStringAsFixed(1)}s.\nAdaptive Difficulty Level: $level\nSaved locally to storage queue.',
          style: const TextStyle(fontSize: 18),
        ),
        actions: [
          ElevatedButton(
            onPressed: () {
              Navigator.pop(context);
              _startNewRound();
            },
            style: ElevatedButton.styleFrom(backgroundColor: Colors.teal),
            child: const Text('Next Round',
                style: TextStyle(color: Colors.white, fontSize: 18)),
          )
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('NER Elderly Cognitive Game'),
        backgroundColor: Colors.teal,
        actions: [
          IconButton(
            icon: const Icon(Icons.cloud_upload),
            onPressed: _syncLocalLogsToServer,
            tooltip: 'Sync Offline Logs',
          )
        ],
      ),
      body: Padding(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          children: [
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                  color: Colors.orange.shade50,
                  borderRadius: BorderRadius.circular(10)),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    'Offline Logs: $pendingLogsCount unsynced',
                    style: const TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                        color: Colors.deepOrange),
                  ),
                  ElevatedButton(
                    onPressed: _syncLocalLogsToServer,
                    style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.deepOrange),
                    child: const Text('Sync Now',
                        style: TextStyle(color: Colors.white)),
                  )
                ],
              ),
            ),
            const SizedBox(height: 20),
            const Text('Tap the matching cultural icon:',
                style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold)),
            const SizedBox(height: 10),
            Container(
              padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 30),
              decoration: BoxDecoration(
                color: Colors.teal.shade50,
                borderRadius: BorderRadius.circular(15),
                border: Border.all(color: Colors.teal, width: 2),
              ),
              child: Text(
                '${targetItem['icon']}  ${targetItem['name']}',
                style: const TextStyle(
                    fontSize: 26,
                    fontWeight: FontWeight.bold,
                    color: Colors.teal),
              ),
            ),
            const SizedBox(height: 25),
            Expanded(
              child: GridView.builder(
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 2,
                  crossAxisSpacing: 15,
                  mainAxisSpacing: 15,
                ),
                itemCount: nerAssets.length,
                itemBuilder: (context, index) {
                  final item = nerAssets[index];
                  return ElevatedButton(
                    onPressed: () => _handleChoice(item),
                    style: ElevatedButton.styleFrom(
                      shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(15)),
                      backgroundColor: Colors.teal.shade100,
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(item['icon']!,
                            style: const TextStyle(fontSize: 45)),
                        const SizedBox(height: 8),
                        Text(
                          item['name']!,
                          style: const TextStyle(
                              fontSize: 16,
                              fontWeight: FontWeight.bold,
                              color: Colors.black87),
                        ),
                      ],
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
